# Fresh Calibration-only private key. Never use a mainnet wallet.
FILECOIN_PRIVATE_KEY=
# Needed only for the authenticated POST /api/agent route. CLI worker uses local env.
AGENT_API_TOKEN=
AGENT_MAX_TOPUP_USDFC=2
# Optional public RPC override and watched address (when no signer is configured).
FILECOIN_RPC_URL=https://api.calibration.node.glif.io/rpc/v1
NEXT_PUBLIC_AGENT_ADDRESS=0xA704353cB48030557c307cB743581D49eFA1eF80
# Optional persistent directory and custom memory JSON file.
# MEMENTO_DATA_DIR=./data
# MEMENTO_MEMORIES_PATH=./memories.json
